generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CorSistema {
  id            Int            @id @default(autoincrement())
  cor           String
  valor         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  configuracaos Configuracao[] @relation("ConfiguracoesCoresSistema")
}

model Configuracao {
  id             Int          @id @default(autoincrement())
  nomePlataforma String
  slogan         String
  sobreCurso     String
  emailContato   String
  logoAplicativo String
  logoSistema    String
  favicon        String
  fotoCapa       String
  coresSistema   CorSistema[] @relation("ConfiguracoesCoresSistema")
  telefone       String
  endereco       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Tema {
  id          Int       @id @default(autoincrement())
  nome        String
  professorId String
  professor   User      @relation("AvaliacoesProfessor", fields: [professorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  disponivel  Boolean   @default(true)
  entrega     DateTime?

  Avaliacao Avaliacao[]
}

enum StatusAvaliacao {
  ENVIADA // Aluno enviou a resposta
  CORRIGIDA // Correção concluída
}

enum StatusExercicio {
  ENVIADA
  CORRIGIDA
}

model Avaliacao {
  id          Int                 @id @default(autoincrement())
  alunoId     String
  aluno       User                @relation("AvaliacoesAluno", fields: [alunoId], references: [id])
  professorId String?
  professor   User?               @relation("AvaliacoesProfessor", fields: [professorId], references: [id])
  temaId      Int
  tema        Tema                @relation(fields: [temaId], references: [id])
  criterios   CriterioAvaliacao[]
  resposta    String
  correcao    String?
  status      StatusAvaliacao     @default(ENVIADA)
  notaFinal   Int
  feedback    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([alunoId, status])
  @@index([professorId, status])
  @@index([createdAt])
  @@index([temaId, status])
}

model CriterioAvaliacao {
  id          Int       @id @default(autoincrement())
  avaliacaoId Int
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id])
  criterioId  Int
  criterio    Criterio  @relation(fields: [criterioId], references: [id])
  pontuacao   Int

  submissoes SubmissaoExercicio[] @relation("CriterioAvaliacaoSubmissoes")
}

model Criterio {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String
  pontuacaoMax Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  CriterioAvaliacao CriterioAvaliacao[]
}

// Enum para status da mentoria

enum StatusMentoria {
  AGENDADA
  CONFIRMADA
  REALIZADA
}

model DiaSemana {
  id        Int      @id @default(autoincrement())
  dia       Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Boolean  @default(false)

  horarios Horario[]
}

model SlotHorario {
  id        Int      @id @default(autoincrement())
  nome      String
  status    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Horario Horario[]
}

model Horario {
  id     Int      @id @default(autoincrement())
  data   DateTime @db.Date // Apenas data, sem horário
  status Boolean  @default(true) // true = disponível, false = ocupado (4 mentorias)

  mentorias Mentoria[]

  // Permite até 4 mentorias por horário (data + slot)
  // ERRO: Não é permitido usar campos de relação em índices únicos
  // Solução: Use o campo de chave estrangeira scalar `slotId` ao invés do objeto de relação `slot`
  slotId      Int
  slot        SlotHorario @relation(fields: [slotId], references: [id])
  diaSemanaId Int
  diaSemana   DiaSemana   @relation(fields: [diaSemanaId], references: [id])
  updatedAt   DateTime    @updatedAt

  // Índices para otimizar consultas de disponibilidade
  // Otimiza busca por data+slot com status
  // Otimiza filtros por disponibilidade
  @@unique([data, slotId])
  @@index([data, slotId, status])
  @@index([status])
}

model Mentoria {
  id          Int            @id @default(autoincrement())
  alunoId     String
  aluno       User           @relation("MentoriasAluno", fields: [alunoId], references: [id])
  professorId String?
  professor   User?          @relation("MentoriasProfessor", fields: [professorId], references: [id])
  horarioId   Int
  horario     Horario        @relation(fields: [horarioId], references: [id])
  status      StatusMentoria @default(AGENDADA)
  duracao     Int            @default(20) // Duração em minutos
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Garante que um aluno só possa ter uma mentoria por horário
  // Índices para otimizar consultas
  // Filtra mentorias por status
  // Otimiza contagem de mentorias ativas por horário
  @@unique([alunoId, horarioId])
  @@index([status])
  @@index([horarioId, status])
}

model Modulo {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videoaulas Videoaula[]
}

model Videoaula {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  urlVideo     String
  urlThumbnail String
  duracao      Int
  moduloId     Int
  modulo       Modulo   @relation(fields: [moduloId], references: [id])
  professorId  String?
  professor    User?    @relation("VideoaulasProfessor", fields: [professorId], references: [id])
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progressos ProgressoVideoaula[]
  exercicio Exercicio?
}

model Exercicio {
  id          Int       @id @default(autoincrement())
  videoaulaId Int       @unique
  videoaula   Videoaula @relation(fields: [videoaulaId], references: [id])

  titulo      String
  enunciado   String
  notaMaxima  Int       @default(100)
  disponivel  Boolean   @default(true)
  ordem       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissoes SubmissaoExercicio[]

  @@index([videoaulaId, ordem])
}

model SubmissaoExercicio {
  id          Int             @id @default(autoincrement())
  exercicioId Int
  exercicio   Exercicio       @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  alunoId     String
  aluno       User            @relation("SubmissaoExercicioAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  professorId String?
  professor   User?           @relation("SubmissaoExercicioProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  resposta    String
  correcao    String?
  feedback    String?
  nota        Int? // só existe depois de corrigida
  status      StatusExercicio @default(ENVIADA)
  corrigidaEm DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Um envio por aluno em cada exercício.
  // Para permitir reenvio: adicionar `tentativa Int @default(1)` e incluir na unique.
  @@unique([exercicioId, alunoId])
  @@index([alunoId, status])
  @@index([professorId, status])
  criterioAvaliacaos CriterioAvaliacao[] @relation("CriterioAvaliacaoSubmissoes")
}

// Progresso individual do aluno em cada videoaula
model ProgressoVideoaula {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoaulaId     Int
  videoaula       Videoaula @relation(fields: [videoaulaId], references: [id], onDelete: Cascade)
  posicaoSegundos Int       @default(0) // onde o aluno parou (retomar de onde parou)
  concluidoEm     DateTime? // definido uma vez (ex.: ao passar de 90%) e nunca desfeito
  ultimoAcessoEm  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, videoaulaId])
  @@index([userId, ultimoAcessoEm]) // "continuar assistindo"
}

model User {
  id                      String               @id
  name                    String
  email                   String
  emailVerified           Boolean
  image                   String?
  createdAt               DateTime
  updatedAt               DateTime
  sessions                Session[]
  accounts                Account[]
  role                    String?
  matriculado             Boolean?             @default(false)
  banned                  Boolean?             @default(false)
  banReason               String?
  banExpires              DateTime?
  avaliacoesComoAluno     Avaliacao[]          @relation("AvaliacoesAluno")
  avaliacoesComoProfessor Avaliacao[]          @relation("AvaliacoesProfessor")
  mentoriasComoAluno      Mentoria[]           @relation("MentoriasAluno")
  mentoriasComoProfessor  Mentoria[]           @relation("MentoriasProfessor")
  especialidade           String?
  telefone                String?
  bio                     String?
  // Relação com tokens FCM
  temas                   Tema[]               @relation("AvaliacoesProfessor")
  pushSubscriptions       PushSubscription[]
  videoaulas              Videoaula[]          @relation("VideoaulasProfessor")
  progressos              ProgressoVideoaula[]
  submissoesExercicioAluno      SubmissaoExercicio[]  @relation("SubmissaoExercicioAluno")
  submissoesExercicioProfessor  SubmissaoExercicio[]  @relation("SubmissaoExercicioProfessor")

  @@unique([email])
  @@index([email, role])
  @@index([matriculado])
  @@map("user")
}

model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String // Chave pública de encriptação
  auth       String // Segredo de autenticação
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([endpoint])
  @@map("push_subscription")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}
